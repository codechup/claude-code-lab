{
  "permissions": {
    "allow": ["Bash(npm test)", "Bash(npm run typecheck)", "Bash(npm run lint)", "Bash(git status:*)", "Bash(git diff:*)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-dangerous-commands.mjs"
          }
        ]
      }
    ]
  }
}
