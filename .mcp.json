{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "labtrack": {
      "command": "node",
      "args": ["mcp/src/index.ts"],
      "env": {
        "LABTRACK_DATA_FILE": "${LABTRACK_DATA_FILE:-.labtrack-data.json}"
      }
    }
  }
}
