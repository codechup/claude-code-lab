{
  "name": "claude-code-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Hands-on lab repository for the CodeChup Claude Code Academy (cc.codechup.com)",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "labtrack": "./src/cli.ts"
  },
  "scripts": {
    "start": "node src/cli.ts",
    "api": "node src/api/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "hygiene": "node scripts/check-public-hygiene.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^9.15.0",
    "prettier": "^3.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.15.0",
    "vitest": "^5.0.0"
  }
}
